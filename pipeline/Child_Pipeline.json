{
	"name": "Child_Pipeline",
	"properties": {
		"activities": [
			{
				"name": "lookup_maxvalue",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": "@concat('SELECT MAX(', pipeline().parameters.WatermarkColumn, ') AS NewWatermarkValue FROM ', pipeline().parameters.TableSchema, '.', pipeline().parameters.TableName)",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "sql_ssms",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "If Condition1",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "lookup_maxvalue",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@or(equals(activity('lookup_maxvalue').output.firstRow.NewWatermarkValue, json('null')), greater(activity('lookup_maxvalue').output.firstRow.NewWatermarkValue, pipeline().parameters.LastLoadValue))",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"TableName": {
				"type": "string"
			},
			"TableSchema": {
				"type": "string"
			},
			"WatermarkColumn": {
				"type": "string"
			},
			"LastLoadValue": {
				"type": "string"
			}
		},
		"annotations": []
	}
}