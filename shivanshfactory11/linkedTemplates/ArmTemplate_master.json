{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "shivanshfactory11"
		},
		"AzureDataLakeStorage1_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage1'"
		},
		"LS_ADLS_CSV_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS_CSV'"
		},
		"LS_csv_cusotmers_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'LS_csv_cusotmers'"
		},
		"ls_sql_source_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_sql_source'"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://shivanshstorage11.dfs.core.windows.net/"
		},
		"LS_ADLS_CSV_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://practicestorage111.dfs.core.windows.net/"
		},
		"ls_sql_source_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "DESKTOP-KLGM537"
		},
		"ls_sql_source_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "TelecomDB"
		},
		"ls_sql_source_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sa"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "shivanshfactory11_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDataLakeStorage1_accountKey": {
						"value": "[parameters('AzureDataLakeStorage1_accountKey')]"
					},
					"LS_ADLS_CSV_accountKey": {
						"value": "[parameters('LS_ADLS_CSV_accountKey')]"
					},
					"LS_csv_cusotmers_connectionString": {
						"value": "[parameters('LS_csv_cusotmers_connectionString')]"
					},
					"ls_sql_source_password": {
						"value": "[parameters('ls_sql_source_password')]"
					},
					"AzureDataLakeStorage1_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorage1_properties_typeProperties_url')]"
					},
					"LS_ADLS_CSV_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_CSV_properties_typeProperties_url')]"
					},
					"ls_sql_source_properties_typeProperties_server": {
						"value": "[parameters('ls_sql_source_properties_typeProperties_server')]"
					},
					"ls_sql_source_properties_typeProperties_database": {
						"value": "[parameters('ls_sql_source_properties_typeProperties_database')]"
					},
					"ls_sql_source_properties_typeProperties_userName": {
						"value": "[parameters('ls_sql_source_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}